const { sql, poolPromise } = require('../../../db');

module.exports = async (req, res) => {
    try {
        const body = req.body || {};
        const user = req.user || {};

        const filtro = body.filtro !== undefined ? parseInt(body.filtro, 10) : 0;
        const filtroCalle = body.filtroCalle !== undefined ? parseInt(body.filtroCalle, 10) : 1;
        
        // Contexto del operador autenticado
        const nroFlota = user.nro_flota !== undefined && user.nro_flota !== null ? parseInt(user.nro_flota, 10) : 0;
        const choferViaja = body.choferViaja !== undefined ? parseInt(body.choferViaja, 10) : 1;
        let filtroMesas = '';
        if (user.nro_mesas && user.nro_mesas !== '0') {
            const mesas = String(user.nro_mesas).split('');
            filtroMesas = ' AND (nromesaDespacho = 0';
            for (const mesa of mesas) {
                filtroMesas += ` OR nromesaDespacho = ${parseInt(mesa, 10)}`;
            }
            filtroMesas += ')';
        }

        const pool = await poolPromise;
        const result = await pool.request()
            .input('Filtro', sql.Int, filtro)
            .input('FiltroCalle', sql.Int, filtroCalle)
            .input('NroFlota', sql.Int, nroFlota)
            .input('ChoferViaja', sql.Int, choferViaja)
            .input('FiltroMesas', sql.VarChar(sql.MAX), filtroMesas)
            .execute('dbo.CFR_GetViajesFlota');

        res.json({
            success: true,
            data: result.recordset
        });
    } catch (err) {
        console.error('Error getViajesFlota: ', err);
        res.status(500).json({
            success: false,
            error: 'Error interno del servidor al procesar los viajes'
        });
    }
};