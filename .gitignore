# Dependencias (¡El más importante!)
node_modules/
/.pnp
.pnp.js

# Archivos de entorno y secretos (¡Nunca subas esto!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Carpetas de construcción / compilación (Si usas TypeScript, React, etc.)
dist/
build/
out/

# Reportes de pruebas (Testing)
coverage/
.nyc_output/

# Archivos del Sistema Operativo (Basura que generan Mac/Windows)
.DS_Store
Thumbs.db

# Caché de herramientas
.npm
.eslintcache
.parcel-cache
.next/